classDiagram
    class Owner {
        +str name
        +list~Pet~ pets
        +dict preferences
        +int availability
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task) None
    }

    class Task {
        +str name
        +str category
        +int duration
        +str priority
        +str preference
        +str frequency
        +bool completed
        +mark_complete() None
    }

    class Plan {
        +list~Task~ scheduled_items
        +list~Task~ skipped_tasks
        +explain() str
    }

    Owner "1" --> "*" Pet : has
    Pet "1" --> "*" Task : has
    Plan "1" o-- "*" Task : schedules
    Plan ..> Owner : uses preferences and availability

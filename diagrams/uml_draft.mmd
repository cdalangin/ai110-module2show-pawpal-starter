classDiagram
    class Owner {
        +str name
        +list~Pet~ pets
        +dict preferences
        +int availability
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task) None
    }

    class Task {
        +str name
        +str category
        +int duration
        +str priority
        +str pet_name
        +str preference
        +str frequency
        +bool completed
        +mark_complete() None
    }

    class Scheduler {
        +Owner owner
        +list~Task~ scheduled_items
        +list~Task~ skipped_tasks
        +generate_plan() list~Task~
        +explain() str
    }

    Owner "1" --> "*" Pet : has
    Pet "1" --> "*" Task : has
    Scheduler "1" --> "1" Owner : schedules for
    Scheduler "1" o-- "*" Task : scheduled
    Scheduler "1" o-- "*" Task : skipped
    Owner ..> Task : collects via get_all_tasks
